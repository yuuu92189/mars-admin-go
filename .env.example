APP_ENV=development
APP_NAME=Mars Admin Go Edition
APP_VERSION=0.1.0
APP_PORT=8080
APP_LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=20s
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTO_MIGRATE=true

DATABASE_URL=postgres://mars:mars_dev_only@localhost:5432/mars_admin?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_CONNECTION_TIMEOUT=10s

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

AUTH_SESSION_TTL=30m
AUTH_REFRESH_TTL=720h
AUTH_REFRESH_GRACE_PERIOD=15s
AUTH_REFRESH_HISTORY_RETENTION=720h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Comma-separated CIDRs for reverse proxies whose X-Forwarded-* headers are trusted.
# Leave empty when clients connect directly.
AUTH_TRUSTED_PROXY_CIDRS=
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_DURATION=30m
AUTH_CAPTCHA_ENABLED=false

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files
STORAGE_MAX_UPLOAD_BYTES=52428800
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

SMS_PROVIDER=console
ALIYUN_SMS_ENDPOINT=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_NOTICE_TEMPLATE=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_ENDPOINT=
PUSH_WEBHOOK_PROVIDER=webhook
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
WECHAT_PAY_ENDPOINT=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NUMBER=
WECHAT_PAY_PRIVATE_KEY_PEM=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM=
WECHAT_PAY_PLATFORM_SERIAL_NUMBER=
ALIPAY_ENDPOINT=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PEM=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mars-admin-api

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid

# Compose-only runtime fallback for networks that block gcr.io. The standalone
# Dockerfile production default remains distroless.
RUNTIME_IMAGE=alpine:3.22
