# Single server-side Go API target. Browser traffic always uses Next's same-origin proxy.
API_BASE_URL=http://localhost:8080

# Deprecated compatibility aliases. They are accepted only when they agree with
# API_BASE_URL (or with each other when API_BASE_URL is absent).
# API_PROXY_TARGET=http://localhost:8080
# API_INTERNAL_BASE_URL=http://localhost:8080
